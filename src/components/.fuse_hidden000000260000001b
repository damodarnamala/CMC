// Portrait: tries the fallback file once, then shows initials
const Portrait: React.FC<{ src: string; fallbackSrc: string; initials: string; alt: string }> = ({
  src, fallbackSrc, initials, alt,
}) => {
  const [current, setCurrent] = useState(src);
  const [failed, setFailed] = useState(false);
  if (failed) {
    return (
      <div className="w-full h-full bg-gradient-to-br from-amber-500/20 via-slate-900 to-black flex items-center justify-center font-cinzel font-bold text-2xl text-amber-400">
        {initials}
      </div>
    );
  }
  return (
    <img
      src={current}
      alt={alt}
      referrerPolicy="no-referrer"
      className="w-full h-full object-cover object-top"
      onError={() => (current !== fallbackSrc ? setCurrent(fallbackSrc) : setFailed(true))}
    />
  );
};

const SocialIcons: React.FC<{ socials?: Socials }> = ({ socials }) => {
  if (!socials) return null;
  const items = [
    { href: socials.linkedin, label: 'LinkedIn', hover: 'hover:text-sky-400', Icon: Linkedin },
    { href: socials.instagram, label: 'Instagram', hover: 'hover:text-pink-400', Icon: Instagram },
    { href: socials.facebook, label: 'Facebook', hover: 'hover:text-blue-400', Icon: Facebook },
  ].filter((i) => i.href);
  return (
    <div className="flex items-center gap-3">
      {items.map(({ href, label, hover, Icon }) => (
        <a key={label} href={href} target="_blank" rel="noopener noreferrer" title={label} aria-label={label}
          className={`text-slate-200 ${hover} transition-colors`}>
          <Icon className="w-4 h-4" />
        </a>
      ))}
    </div>
  );
};


@import "tailwindcss";
@import "./design-system.css";

@layer base {
  :root {
    --color-obsidian: #08090d;
    --color-noir: #0e1117;
    --color-surface-card: #131824;
    --color-surface-hover: #182030;
    --color-gold-400: #fbbf24;
    --color-gold-500: #e6af2e;
    --color-gold-600: #d97706;
  }

  body {
    background-color: #08090d;
    color: #e2e8f0;
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    overflow-x: hidden;
  }

  h1, h2, h3, .font-cinzel {
    font-family: 'Cinzel', serif;
  }

  .font-cinzel-deco {
    font-family: 'Cinzel Decorative', serif;
  }

  .font-syne {
    font-family: 'Syne', sans-serif;
  }
}

/* Ambient atmospheric radial lights */
.ambient-radial-glow {
  background: radial-gradient(circle at 50% 12%, rgba(230, 175, 46, 0.09) 0%, transparent 55%),
              radial-gradient(circle at 82% 45%, rgba(0, 168, 225, 0.07) 0%, transparent 50%),
              radial-gradient(circle at 18% 78%, rgba(255, 0, 51, 0.05) 0%, transparent 50%);
}

/* Clean metallic liquid gold text */
.gold-luxury-text {
  background: linear-gradient(135deg, #ffffff 0%, #fde68a 35%, #e6af2e 70%, #b47814 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.gold-gradient-border {
  border-image: linear-gradient(to bottom right, rgba(251, 191, 36, 0.5), rgba(230, 175, 46, 0.1), rgba(255, 255, 255, 0.05)) 1;
}

/* ======================================================== */
/* Animated Gold Border Effect for Main CMC Logo            */
/* ======================================================== */
@keyframes gold-border-spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes gold-shimmer-pulse {
  0%, 100% {
    box-shadow: 0 0 25px -4px rgba(230, 175, 46, 0.35), 0 0 10px rgba(251, 191, 36, 0.2);
  }
  50% {
    box-shadow: 0 0 45px 4px rgba(251, 191, 36, 0.7), 0 0 20px rgba(255, 236, 160, 0.5);
  }
}

.gold-animated-border-frame {
  position: relative;
  border-radius: 1.75rem;
  padding: 2.5px;
  overflow: hidden;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  animation: gold-shimmer-pulse 4s ease-in-out infinite;
}

.gold-animated-border-frame::before {
  content: '';
  position: absolute;
  inset: -150%;
  background: conic-gradient(
    from 0deg,
    transparent 0deg,
    rgba(212, 175, 55, 0.1) 40deg,
    #f59e0b 80deg,
    #ffd700 110deg,
    #fff7d1 135deg,
    #d4af37 160deg,
    transparent 200deg,
    rgba(212, 175, 55, 0.1) 240deg,
    #f59e0b 280deg,
    #ffd700 310deg,
    #fff7d1 335deg,
    transparent 360deg
  );
  animation: gold-border-spin 5s linear infinite;
}

.gold-animated-border-content {
  position: relative;
  z-index: 10;
  border-radius: calc(1.75rem - 2.5px);
  background: radial-gradient(circle at 50% 50%, rgba(18, 22, 32, 0.96) 0%, rgba(7, 9, 13, 0.98) 100%);
  padding: 1.25rem 2.25rem;
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.9), inset 0 1px 1px rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Hyperframes / Jitter 3D Perspective Wrapper */
.jitter-perspective {
  perspective: 1200px;
  display: inline-block;
}

.tilted-text-item {
  display: inline-block;
  transform-origin: center bottom;
  transform-style: preserve-3d;
  will-change: transform, opacity, filter;
}

/* Clean Jitter text scramble highlighted characters */
.scramble-glyph {
  display: inline-block;
  color: #e6af2e;
  font-weight: 700;
  opacity: 0.95;
  transition: opacity 0.15s ease;
}

/* Modern glass card */
.glass-card {
  background: rgba(19, 24, 36, 0.72);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}
.glass-card:hover {
  border-color: rgba(230, 175, 46, 0.35);
  box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.7), 0 0 25px -10px rgba(230, 175, 46, 0.2);
}

/* Prime Video Launch Button */
.btn-launch-prime {
  position: relative;
  background: linear-gradient(135deg, #00A8E1 0%, #007EA7 50%, #005F7F 100%);
  color: #ffffff;
  font-weight: 700;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 6px 20px -3px rgba(0, 168, 225, 0.4);
  border: 1px solid rgba(56, 189, 248, 0.4);
}
.btn-launch-prime::after {
  content: '';
  position: absolute;
  top: 0;
  left: -120%;
  width: 70%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
  transform: skewX(-20deg);
  transition: left 0.6s ease;
}
.btn-launch-prime:hover::after {
  left: 140%;
}
.btn-launch-prime:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(0, 168, 225, 0.6);
  filter: brightness(1.08);
}


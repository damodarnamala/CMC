/* ============================================================
   Cinematic hero: wallpaper, logo reveal, light sweep, rise-in
   ============================================================ */

/* Wallpaper with a slow Ken Burns drift (skydance-style hero backdrop) */
@keyframes cmc-kenburns {
  from { transform: scale(1.08) translate3d(0, 0, 0); }
  to   { transform: scale(1) translate3d(0, -1.2%, 0); }
}
.cmc-wallpaper {
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  transform-origin: center center;
  will-change: transform;
  animation: cmc-kenburns 24s ease-in-out infinite alternate;
}

/* Dark veil so the wallpaper never fights the copy; fades into the page below */
.cmc-wallpaper-veil {
  background:
    radial-gradient(ellipse at center, rgba(8, 9, 13, 0.25) 0%, rgba(8, 9, 13, 0.8) 72%),
    linear-gradient(to bottom, rgba(8, 9, 13, 0.55) 0%, rgba(8, 9, 13, 0.25) 35%, rgba(8, 9, 13, 0.7) 75%, #08090d 100%);
}

/* Warm light leak that breathes behind the logo */
@keyframes cmc-glow-breathe {
  from { opacity: 0.45; transform: scale(0.96); }
  to   { opacity: 1;    transform: scale(1.04); }
}
.cmc-light-leak {
  background: radial-gradient(circle at 50% 36%, rgba(251, 191, 36, 0.22) 0%, rgba(230, 175, 46, 0.06) 30%, transparent 60%);
  animation: cmc-glow-breathe 6s ease-in-out infinite alternate;
  mix-blend-mode: screen;
}

/* Logo: blurred, oversized light burst that resolves into the mark */
@keyframes cmc-logo-in {
  0%   { opacity: 0; transform: scale(1.35); filter: blur(16px) brightness(1.8) drop-shadow(0 0 0 rgba(251, 191, 36, 0)); }
  55%  { opacity: 1; filter: blur(0) brightness(1.3) drop-shadow(0 0 36px rgba(251, 191, 36, 0.55)); }
  100% { opacity: 1; transform: scale(1); filter: blur(0) brightness(1) drop-shadow(0 0 22px rgba(212, 175, 55, 0.35)); }
}
.cmc-logo-reveal {
  animation: cmc-logo-in 2.2s cubic-bezier(0.16, 1, 0.3, 1) both;
}

/* Light sweep clipped to the logo shape (mask uses the same PNG) */
@keyframes cmc-sweep {
  0%        { background-position: 160% 0; }
  45%, 100% { background-position: -60% 0; }
}
.cmc-logo-sweep {
  background-image: linear-gradient(105deg, transparent 38%, rgba(255, 248, 215, 0.95) 50%, transparent 62%);
  background-size: 260% 100%;
  background-repeat: no-repeat;
  mix-blend-mode: screen;
  -webkit-mask-size: 100% 100%;
  mask-size: 100% 100%;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  animation: cmc-sweep 5.5s ease-in-out 2.4s infinite;
}

/* Brushed-silver subtitle, like the wallpaper lockup */
.cmc-silver-text {
  background: linear-gradient(180deg, #ffffff 0%, #d6d9de 45%, #8b9099 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}

/* Staggered rise-in for hero copy */
@keyframes cmc-rise {
  from { opacity: 0; transform: translate3d(0, 18px, 0); filter: blur(4px); }
  to   { opacity: 1; transform: none; filter: blur(0); }
}
.cmc-rise {
  animation: cmc-rise 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
  animation-delay: var(--d, 0s);
}

@media (prefers-reduced-motion: reduce) {
  .cmc-wallpaper,
  .cmc-light-leak,
  .cmc-logo-sweep,
  .cmc-logo-reveal,
  .cmc-zoom-in,
  .cmc-rise {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
    filter: none !important;
  }
}

/* Bottom fade from the full-screen wallpaper into the page */
.cmc-hero-fade {
  background: linear-gradient(to bottom, rgba(8, 9, 13, 0) 0%, #08090d 100%);
}

/* Gold embossed lettering that matches the CMC mark */
.cmc-gold-emboss {
  background: linear-gradient(180deg, #fbf4d4 0%, #eed49e 30%, #d5b27f 55%, #bc9362 80%, #e2c382 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  filter:
    drop-shadow(0 1px 0 rgba(255, 240, 190, 0.45))
    drop-shadow(0 -1px 0 rgba(0, 0, 0, 0.9))
    drop-shadow(0 4px 8px rgba(0, 0, 0, 0.75))
    drop-shadow(0 0 14px rgba(212, 175, 55, 0.35));
}

/* Logo and subtitle zoom in once the lights reach the centre (~3.2s) */
@keyframes cmc-zoom-in {
  from { opacity: 0; transform: scale(0.35); }
  to   { opacity: 1; transform: scale(1); }
}
.cmc-zoom-in {
  opacity: 0;
  animation: cmc-zoom-in 1.5s cubic-bezier(0.16, 1, 0.3, 1) 3.2s forwards;
}

/* Gold gradient for the tagline, using the logo's gold tones */
.cmc-gold-gradient-text {
  background: linear-gradient(90deg, #fbf4d4 0%, #eed49e 25%, #d5b27f 50%, #eed49e 75%, #fbf4d4 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}

/* Snap scrolling: the wallpaper and the tagline section are snap points */
html {
  scroll-snap-type: y proximity;
  /* keep snap points clear of the fixed navigation bar */
  scroll-padding-top: 6.5rem;
}
#hero,
#hero-content,
#leadership-header {
  scroll-snap-align: start;
}

/* Phones in portrait: shorter wallpaper so the content below shows sooner */
@media (orientation: portrait) and (max-width: 767px) {
  #hero {
    height: 75svh;
  }
}

/* Stop accidental sideways scrolling/shift on phones */
html,
body {
  overflow-x: hidden;
  max-width: 100%;
}
